FROM golang:1.24

WORKDIR /app

# Install air first (this layer will be cached unless the base image changes)
RUN go install github.com/air-verse/air@latest

# Copy go.mod and go.sum first for better caching
COPY go.mod go.sum ./
RUN go mod download

# Copy .env file
COPY .env .

# Copy source code last (this changes most frequently)
COPY . .

CMD ["air"]